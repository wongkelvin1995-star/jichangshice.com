---
/**
 * 品牌测速记录页：一个品牌在三类测试数据（速度实测 / 节点在线状态核验 / 公开测速参考）里的全部内容。
 * 三类分区展示、分开统计；资料较少的品牌如实写明，不用估算数据补充。
 */
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BrandAvatar from "@/components/BrandAvatar.astro";
import CompletenessMatrix from "@/components/CompletenessMatrix.astro";
import EntryLink from "@/components/EntryLink.astro";
import TestRecordCard from "@/components/TestRecordCard.astro";
import OwnRunsTable from "@/components/OwnRunsTable.astro";
import NodeStatusChart from "@/components/NodeStatusChart.astro";
import TestPhotoCard from "@/components/TestPhoto.astro";
import { photosOf } from "@/data/test-photos";
import { nodeChecksOf } from "@/data/node-checks";
import { getProviders } from "@/utils/plans";
import { getTestRecords, recordsOf } from "@/utils/testRecords";
import { getVerifiedRuns, runsOf } from "@/utils/testRuns";
import { brandStatsText, isBrandTopic } from "@/utils/testStats";
import { collectRegions } from "@/utils/testRegions";
import { nodeCheckFields, runFields } from "@/utils/dataCompleteness";
import { breadcrumbJsonLd } from "@/utils/jsonld";
import config from "@/config";

export async function getStaticPaths() {
  const providers = await getProviders();
  const records = await getTestRecords();
  const runs = getVerifiedRuns();
  const items = providers
    .map(p => ({
      p,
      rs: recordsOf(records, p.slug),
      own: runsOf(runs, p.slug),
    }))
    .filter(
      x =>
        x.rs.length > 0 ||
        x.own.length > 0 ||
        nodeChecksOf(x.p.slug).length > 0 ||
        photosOf(x.p.slug).length > 0
    );
  const siblings = items.map(x => ({ slug: x.p.slug, name: x.p.name }));
  return items.map(x => ({
    params: { slug: x.p.slug },
    props: { ...x, siblings, topic: isBrandTopic(x.p.slug, records) },
  }));
}
const { p, rs, own, siblings, topic } = Astro.props;
const checks = nodeChecksOf(p.slug);
const photos = photosOf(p.slug);
const allRecords = await getTestRecords();
// 三类数据分开统计：速度实测（条）、节点在线状态核验（条）、公开测速参考（批）
const counts = { speed: own.length, node: checks.length, public: rs.length };
const statsText = brandStatsText(counts, { sep: "、" });
const path = `/test-records/${p.slug}/`;
const crumbs = [
  { name: "机场实测档案", href: "/test-records/" },
  { name: `${p.name}测速记录` },
];
const evidence = rs.reduce(
  (n, r) => n + r.data.rows.filter(x => x.evidenceUrl).length,
  0
);
const dates = [
  ...rs.map(r => r.data.recordedAt),
  ...own.map(r => r.testedAt.slice(0, 10)),
  ...checks.map(c => c.date),
].sort();
const range =
  dates[0] === dates.at(-1) ? dates[0] : `${dates[0]} 至 ${dates.at(-1)}`;
const hasPeak = rs.some(r =>
  [r.data.window, ...r.data.rows.map(x => x.window)].some(w =>
    w?.includes("晚高峰")
  )
);
// 这个品牌出现在哪些地区专题页
const regionLinks = collectRegions(allRecords).filter(
  r =>
    r.hasPage &&
    (r.brands.includes(p.slug) ||
      r.runs.some(x => x.brandSlug === p.slug) ||
      r.nodeChecks.some(c => c.brandSlug === p.slug))
);
const runMatrix = own.map(r => ({
  label: `${r.nodeRegion}节点`,
  fields: runFields(r),
}));
const nodeMatrix = checks.map(c => ({
  label: c.date,
  fields: nodeCheckFields(c),
}));
---

<Layout
  title={`${p.name}测速记录：${statsText ?? "暂无测速记录"}｜${config.site.title}`}
  description={`${p.name}测速记录（${range}）：${statsText ?? "暂无测速记录"}${evidence ? `，其中公开测速参考有 ${evidence} 条附 Speedtest 原始结果链接` : ""}。注明测试地点、运营商、宽带、工具、服务器与数据局限，未验证的项目标注待验证。`}
  canonicalPath={path}
  ogImage={photos[0]?.src}
  ogImageAlt={photos[0]
    ? `${p.name}机场实测图：${photos[0].date} ${photos[0].nodeRegion}节点测速汇总`
    : undefined}
  ogImageSize={photos[0]
    ? { width: photos[0].width, height: photos[0].height }
    : undefined}
  jsonLd={[
    breadcrumbJsonLd(crumbs, path),
    ...photos.map(t => ({
      "@context": "https://schema.org",
      "@type": "ImageObject",
      contentUrl: new URL(t.src, config.site.url).href,
      name: `${p.name}机场实测图 · ${t.nodeRegion}节点（${t.date}）`,
      caption: `${p.name} ${t.date} ${t.nodeRegion}节点：下载 ${t.downloadMbps} Mbps、上传 ${t.uploadMbps} Mbps、延迟 ${t.latencyMs} ms`,
      width: t.width,
      height: t.height,
      datePublished: t.publishedAt,
      creator: { "@type": "Organization", name: config.site.title },
    })),
  ]}
>
  <main id="main-content" data-pagefind-body>
    <section class="hero-band relative border-b">
      <div class="app-layout relative py-8 sm:py-10">
        <Breadcrumbs items={crumbs} />
        <div class="flex items-start gap-4">
          <BrandAvatar name={p.name} />
          <div class="min-w-0">
            <h1
              class="text-[1.6rem] leading-snug font-black tracking-tight sm:text-[2.1rem]"
            >
              {p.name}测速记录
            </h1>
            <p
              class="text-muted-foreground mt-2 max-w-3xl leading-relaxed"
              data-brand-stats
            >
              {statsText ?? "暂无测速记录"}{
                evidence
                  ? `；公开测速参考中 ${evidence} 条附 Speedtest 原始结果链接`
                  : ""
              }{
                hasPeak ? "，包含晚高峰时段" : ""
              }。三类数据口径不同、分开统计；不同批次的工具和测试端不同，请勿横向比较。
            </p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            p.hasProfile && (
              <a href={`/airports/${p.slug}/`} class="btn btn-outline">
                {p.name}机场测评
              </a>
            )
          }
          <EntryLink
            href={p.entryUrl}
            brand={p.name}
            label="查看当前套餐"
            class="btn btn-primary"
          />
        </div>
      </div>
    </section>

    <div class="app-layout grid grid-cols-[minmax(0,1fr)] gap-8 pt-8">
      {
        !topic && (
          <p class="bg-warn-soft text-warn rounded-xl px-4 py-3 text-sm leading-relaxed">
            {p.name}
            目前资料较少：{own.length === 0 ? "没有本站速度实测，" : ""}
            公开测速参考 {rs.length} 批
            {evidence === 0 ? "，且没有附原始结果链接" : ""}
            。本页只如实列出这些来源，不用估算数据补充；取得原始结果后再更新。
          </p>
        )
      }

      {/* id="own-tests"：旧版页面的锚点，保留以免外部链接（#own-tests）失效 */}
      <section
        id="own-tests"
        class="scroll-mt-24"
        aria-labelledby="speed-title"
      >
        <h2 id="speed-title" class="section-title">
          速度实测（{own.length} 条）
        </h2>
        {
          own.length > 0 ? (
            <div class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-5">
              <OwnRunsTable runs={own} caption={`${p.name}速度实测记录`} />
              <div>
                <h3 class="font-bold">资料完整度</h3>
                <p class="text-muted-foreground mt-1 mb-2 text-xs leading-relaxed">
                  「部分」表示只写了一部分；「待验证」表示截图和记录里都没有，本站不补填。
                </p>
                <CompletenessMatrix
                  rows={runMatrix}
                  firstColumn="实测记录"
                  caption={`${p.name}速度实测资料完整度`}
                />
              </div>
              {photos.length > 0 && (
                <div
                  id="test-photos"
                  class="grid scroll-mt-24 grid-cols-[minmax(0,1fr)] gap-5"
                >
                  {photos.map(t => (
                    <TestPhotoCard
                      photo={t}
                      brandName={p.name}
                      headingLevel="h3"
                    />
                  ))}
                </div>
              )}
            </div>
          ) : (
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              暂无本站速度实测。本站只发布自己测得、附原始截图并核验通过的数据，
              {p.name}还没有这样的记录，也不会用公开测速参考或估算值代替。
            </p>
          )
        }
      </section>

      {
        checks.length > 0 && (
          <section aria-labelledby="node-title">
            <h2 id="node-title" class="section-title">
              节点在线状态核验（{checks.length} 条）
            </h2>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              对照服务商用户面板「节点状态」页截图核对节点在检查时刻是否在线，不是速度测试。
            </p>
            <div class="mt-4 grid grid-cols-[minmax(0,1fr)] gap-5">
              {checks.map(c => (
                <NodeStatusChart check={c} brandName={p.name} />
              ))}
              <CompletenessMatrix
                rows={nodeMatrix}
                firstColumn="核验记录"
                caption={`${p.name}节点在线状态核验资料完整度`}
              />
            </div>
          </section>
        )
      }

      {
        rs.length > 0 && (
          <section aria-labelledby="public-refs" class="grid gap-6">
            <div>
              <h2 id="public-refs" class="section-title">
                公开测速参考（{rs.length} 批）
              </h2>
              <p class="text-muted-foreground mt-2 text-sm">
                他人公开发布的测速记录，不是本站实测。每批注明来源并链接原页面，来源没写的项目标「待验证」。
              </p>
            </div>
            {rs.map(r => (
              <TestRecordCard record={r} headingLevel="h3" />
            ))}
          </section>
        )
      }

      {
        regionLinks.length > 0 && (
          <nav aria-labelledby="by-region" class="card p-5">
            <h2 id="by-region" class="font-bold">
              按地区查看
            </h2>
            <p class="text-muted-foreground mt-1 text-sm">
              {p.name}出现在这些地区专题里（专题只列出数据，不排名）：
            </p>
            <ul class="mt-3 flex flex-wrap gap-2 text-sm">
              {regionLinks.map(r => (
                <li>
                  <a
                    href={`/test-records/region/${r.slug}/#brand-${p.slug}`}
                    class="hover:border-accent/40 hover:text-accent-strong inline-block rounded-full border px-3 py-1"
                  >
                    {r.name}节点测速数据
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <p class="text-muted-foreground text-sm">
        想自己复测？按<a
          href="/methods/record-node-speed-test/"
          class="text-accent-strong underline underline-offset-2"
          >怎样记录一次可复核的节点测速</a
        >操作，并在 20:00–23:00 至少补测一次。其他机场的记录见<a
          href="/test-records/"
          class="text-accent-strong underline underline-offset-2"
          >机场实测档案</a
        >。
      </p>
      <nav aria-labelledby="other-records" class="card p-5">
        <h2 id="other-records" class="font-bold">其他机场的测速记录</h2>
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {
            siblings
              .filter(s => s.slug !== p.slug)
              .map(s => (
                <li>
                  <a
                    href={`/test-records/${s.slug}/`}
                    class="hover:border-accent/40 hover:text-accent-strong inline-block rounded-full border px-3 py-1"
                  >
                    {s.name}测速记录
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>
    </div>
  </main>
</Layout>
