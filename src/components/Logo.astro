---
/** 站点标识：蓝色圆角方块 + 网络节点（原创） */
type Props = { size?: number; class?: string; light?: boolean };
const { size = 28, class: className, light = false } = Astro.props;
const id = `lg${size}${light ? "l" : ""}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <defs>
    <linearGradient id={id} x1="4" y1="2" x2="36" y2="38">
      <stop offset="0" stop-color={light ? "#ffffff" : "#5aa0ff"}></stop>
      <stop offset="1" stop-color={light ? "#cfe0ff" : "#1a6dff"}></stop>
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="36" height="36" rx="11" fill={`url(#${id})`}></rect>
  <path
    d="M12 26 L20 13 L29 18 M20 13 L23 29 M12 26 L23 29"
    stroke={light ? "#1a6dff" : "#ffffff"}
    stroke-opacity="0.55"
    stroke-width="2"
    stroke-linecap="round"></path>
  <circle cx="20" cy="13" r="3.6" fill={light ? "#1a6dff" : "#ffffff"}></circle>
  <circle cx="12" cy="26" r="3" fill={light ? "#1a6dff" : "#ffffff"}></circle>
  <circle cx="29" cy="18" r="2.6" fill={light ? "#0f55d8" : "#dbe9ff"}></circle>
  <circle cx="23" cy="29" r="2.4" fill={light ? "#0f9f8f" : "#b9f3ea"}></circle>
</svg>
