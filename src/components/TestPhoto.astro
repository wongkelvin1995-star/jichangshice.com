---
import type { TestPhoto } from "@/data/test-photos";

type Props = {
  photo: TestPhoto;
  brandName: string;
  headingLevel?: "h2" | "h3";
};
const { photo: t, brandName, headingLevel = "h3" } = Astro.props;
const H = headingLevel;
const alt = `${brandName}机场实测图：${t.date} ${t.nodeRegion}节点，下载 ${t.downloadMbps} Mbps、上传 ${t.uploadMbps} Mbps、延迟 ${t.latencyMs} ms`;
const rows: [string, string][] = [
  ["测试日期", t.time ? `${t.date} ${t.time}` : t.date],
  ["测试节点", t.nodeRegion],
  ["测速工具", t.tool],
  ["测速服务器", t.server ?? "未记录"],
  ["下载速度", `${t.downloadMbps} Mbps`],
  ["上传速度", `${t.uploadMbps} Mbps`],
  ["延迟", `${t.latencyMs} ms`],
  ["抖动", t.jitterMs === null ? "未测" : `${t.jitterMs} ms`],
  ["丢包率", t.packetLossPct === null ? "未测" : `${t.packetLossPct}%`],
  ...t.extra.map(m => [m.label, m.value] as [string, string]),
];
---

<figure
  class="card grid grid-cols-[minmax(0,1fr)] gap-5 p-4 sm:p-5 md:grid-cols-[minmax(0,300px)_minmax(0,1fr)]"
  data-test-photo={t.id}
>
  <a
    href={t.src}
    target="_blank"
    rel="noopener"
    class="block self-start overflow-hidden rounded-xl border border-orange-100 bg-orange-50/40"
    title="查看大图"
  >
    <img
      src={t.src}
      alt={alt}
      width={t.width}
      height={t.height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </a>
  <figcaption class="min-w-0">
    <H class="text-lg font-extrabold">
      {brandName}机场实测图 · {t.nodeRegion}节点（{t.date}）
    </H>
    <p class="mt-1 text-xs font-semibold text-orange-700">
      站长实测 · 附原始测速截图（出口 IP 已打码）
    </p>
    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
      {
        rows.map(([k, v]) => (
          <div class="min-w-0">
            <dt class="text-muted-foreground text-xs">{k}</dt>
            <dd class="font-semibold break-words">{v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 text-xs font-semibold">原始测速截图</p>
    <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
      {
        t.evidence.map((src, i) => (
          <li>
            <a
              href={src}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden rounded-lg border hover:border-orange-300"
            >
              <img
                src={src}
                alt={`${brandName} ${t.nodeRegion}节点测速原始截图 ${i + 1}（${t.date}）`}
                width="320"
                height="160"
                loading="lazy"
                decoding="async"
                class="h-24 w-full object-cover object-top"
              />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-muted-foreground mt-3 text-xs leading-relaxed">
      说明：{t.note}实际表现会因地区、时段与线路波动而不同。
    </p>
  </figcaption>
</figure>
