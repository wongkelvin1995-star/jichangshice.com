---
/** 首屏示意图：测试记录的四个要素。纯装饰 + 文字标签，不包含任何测量数值 */
---

<svg
  viewBox="0 0 420 260"
  class="h-auto w-full max-w-[460px]"
  role="img"
  aria-labelledby="hero-diagram-title"
>
  <title id="hero-diagram-title">
    一次测试记录的四个要素：时间、环境、节点、证据
  </title>
  <g fill="none" stroke="#c9dcf7" stroke-width="1.5" stroke-dasharray="3 5">
    <path d="M30 120 C 90 40, 160 30, 210 90 S 330 170, 395 95"></path>
    <path d="M60 210 C 120 160, 170 150, 210 90"></path>
    <path d="M210 90 C 250 40, 320 30, 360 60"></path>
    <path d="M120 70 C 180 140, 260 200, 330 205"></path>
  </g>
  <g fill="#1677ff">
    <circle cx="210" cy="90" r="6"></circle>
    <circle cx="300" cy="160" r="5" fill="#5ea2ff"></circle>
    <circle cx="395" cy="95" r="5" fill="#5ea2ff"></circle>
    <circle cx="30" cy="120" r="4" fill="#c9dcf7"></circle>
    <circle cx="245" cy="35" r="4" fill="#c9dcf7"></circle>
  </g>
  <g font-family="inherit" font-size="14" fill="#182230" text-anchor="middle">
    <g transform="translate(110 62)">
      <circle r="24" fill="#fff" stroke="#d6e4f7"></circle>
      <circle r="10" fill="none" stroke="#1677ff" stroke-width="2"></circle>
      <path
        d="M0 -5 V0 L4 3"
        stroke="#1677ff"
        stroke-width="2"
        stroke-linecap="round"
        fill="none"></path>
      <text y="44">时间</text>
    </g>
    <g transform="translate(330 52)">
      <circle r="24" fill="#fff" stroke="#d6e4f7"></circle>
      <path
        d="M-9 4 a6 6 0 0 1 1-12 a8 8 0 0 1 15 1 a5 5 0 0 1 2 11 Z"
        fill="none"
        stroke="#1677ff"
        stroke-width="2"></path>
      <text y="44">环境</text>
    </g>
    <g transform="translate(150 175)">
      <circle r="24" fill="#fff" stroke="#d6e4f7"></circle>
      <ellipse
        cx="0"
        cy="-6"
        rx="9"
        ry="3.5"
        fill="none"
        stroke="#1677ff"
        stroke-width="2"></ellipse>
      <path
        d="M-9 -6 V6 a9 3.5 0 0 0 18 0 V-6 M-9 0 a9 3.5 0 0 0 18 0"
        fill="none"
        stroke="#1677ff"
        stroke-width="2"></path>
      <text y="44">节点</text>
    </g>
    <g transform="translate(345 185)">
      <circle r="24" fill="#fff" stroke="#d6e4f7"></circle>
      <rect
        x="-8"
        y="-10"
        width="16"
        height="20"
        rx="2"
        fill="none"
        stroke="#1677ff"
        stroke-width="2"></rect>
      <path d="M-4 -4 H4 M-4 1 H4 M-4 6 H1" stroke="#1677ff" stroke-width="1.6"
      ></path>
      <text y="44">证据</text>
    </g>
  </g>
</svg>
