---
/**
 * 机场工具箱 · 节点可用性检测（全部在访客浏览器内运行，本站不接收任何数据）。
 * 浏览器无法发起原始 TCP 连接，这里用一次 HTTPS 请求测“连接 + 握手”耗时作为近似延迟：
 * 只能说明服务器地址和端口是否有响应、大致多远，不代表代理协议可用或实际速度。
 */
const field =
  "bg-background w-full rounded-lg border px-3 text-sm focus:outline-2 focus:outline-offset-1";
---

<section
  class="not-prose border-accent/20 mt-6 overflow-hidden rounded-2xl border bg-gradient-to-b from-[#f2f7ff] to-white"
  aria-labelledby="node-check-title"
  data-node-check
>
  <div class="border-accent/10 border-b px-4 py-4 sm:px-6">
    <p
      class="bg-accent-soft text-accent-strong inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold"
    >
      <span class="bg-signal size-1.5 rounded-full" aria-hidden="true"></span>
      机场工具箱 · 在线检测
    </p>
    <h2
      id="node-check-title"
      class="mt-2 text-lg font-extrabold sm:text-xl"
      data-toc-ignore
    >
      节点可用性检测
    </h2>
    <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
      检测节点服务器是否有响应、大概多远，快速找出超时和最近的节点。数据只在你的浏览器里处理，不会发送到本站。
    </p>
  </div>

  <div class="grid gap-4 px-4 py-4 sm:px-6 sm:py-5">
    <div>
      <label class="text-sm font-semibold" for="nc-sub"
        >从订阅链接加载节点</label
      >
      <div class="mt-1.5 flex gap-2">
        <input
          id="nc-sub"
          type="url"
          inputmode="url"
          autocomplete="off"
          placeholder="粘贴订阅链接（SS / SSR / V2Ray / Clash）"
          class={`${field} h-11 min-w-0 flex-1`}
          data-sub-url
        />
        <button
          type="button"
          class="btn btn-outline h-11 shrink-0 px-3 text-sm"
          data-load>加载节点</button
        >
      </div>
      <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
        浏览器直接请求订阅地址；多数机场的订阅不允许网页跨域读取，加载失败时，请在客户端里复制订阅内容或节点列表，粘贴到下方。订阅链接相当于账号密码，不要发给别人。
      </p>
    </div>

    <div>
      <label class="text-sm font-semibold" for="nc-input"
        >或手动输入（每行一个：IP:端口 或 域名:端口，也可粘贴订阅内容 / Clash
        配置）</label
      >
      <textarea
        id="nc-input"
        rows="5"
        spellcheck="false"
        class={`${field} num mt-1.5 py-2 text-[0.82rem] leading-relaxed`}
        placeholder={"示例：\n1.1.1.1:443\nexample.com:443\nvless://…@hk1.example.com:443#香港01"}
        data-input></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        class="btn btn-primary h-11 flex-1 px-5 sm:flex-none"
        data-start>开始检测</button
      >
      <button type="button" class="btn btn-outline h-11 px-4 text-sm" data-clear
        >清空</button
      >
      <p
        class="text-muted-foreground w-full text-xs sm:w-auto sm:flex-1 sm:text-end"
        aria-live="polite"
        data-status
      >
      </p>
    </div>

    <div class="hidden" data-result-wrap>
      <div class="grid grid-cols-3 gap-2 text-center" data-summary></div>
      <div class="table-scroll mt-3 rounded-xl border bg-white">
        <table class="w-full min-w-[520px] text-sm">
          <caption class="sr-only">节点检测结果</caption>
          <thead class="bg-muted/50 text-muted-foreground text-xs">
            <tr>
              <th scope="col" class="px-3 py-2 text-start">节点</th>
              <th scope="col" class="px-3 py-2 text-start">地址</th>
              <th scope="col" class="px-3 py-2 text-end">延迟</th>
              <th scope="col" class="px-3 py-2 text-start">状态</th>
            </tr>
          </thead>
          <tbody data-rows></tbody>
        </table>
      </div>
    </div>

    <div
      class="bg-warn-soft text-warn rounded-xl px-3.5 py-3 text-xs leading-relaxed"
    >
      <b>注意：</b>浏览器不能直接发起 TCP
      连接，这里测的是到节点地址一次连接加握手的耗时（近似
      ping），只能说明服务器有没有响应，<b>不代表代理能用，也不代表实际速度</b
      >。检测前请先<b>关闭代理</b>，否则测到的是代理出口到节点的耗时。延迟
      <span class="text-signal font-semibold">100ms 以下</span>为优秀，<span
        class="font-semibold text-amber-600">100–200ms</span
      > 良好，<span class="font-semibold text-orange-600">200–300ms</span>
      可用，<span class="font-semibold text-red-600">300ms 以上或超时</span
      >体验较差。速度请连上节点后用<a
        href="/speedtest/"
        class="underline underline-offset-2">机场网速测试</a
      >测试。
    </div>

    <nav aria-label="相关工具" class="grid gap-2 sm:grid-cols-3">
      {
        [
          {
            href: "/speedtest/",
            t: "机场网速测试",
            d: "测下载、上传、延迟、抖动",
          },
          {
            href: "/clients/clash-subscription-import/",
            t: "订阅导入教程",
            d: "Clash 类客户端导入与核对",
          },
          {
            href: "/troubleshooting/split-routing-issues/",
            t: "分流规则排查",
            d: "规则模式下网站不走代理怎么办",
          },
        ].map(l => (
          <a
            href={l.href}
            class="hover:border-accent/40 rounded-xl border bg-white px-3.5 py-2.5 transition"
          >
            <b class="block text-sm">{l.t}</b>
            <span class="text-muted-foreground text-xs">{l.d}</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<script>
  import { parseNodes, type NodeAddr } from "@/utils/nodeParse";

  // Chrome / Firefox 禁止网页访问的端口：直接标注，不发请求
  const BLOCKED = new Set([
    1, 7, 9, 11, 13, 15, 17, 19, 20, 21, 22, 23, 25, 37, 42, 43, 53, 69, 77, 79,
    87, 95, 101, 102, 103, 104, 109, 110, 111, 113, 115, 117, 119, 123, 135,
    137, 139, 143, 161, 179, 389, 427, 465, 512, 513, 514, 515, 526, 530, 531,
    532, 540, 548, 554, 556, 563, 587, 601, 636, 989, 990, 993, 995, 1719, 1720,
    1723, 2049, 3659, 4045, 5060, 5061, 6000, 6566, 6665, 6666, 6667, 6668,
    6669, 6697, 10080,
  ]);
  const TIMEOUT = 5000;
  const TRIES = 3;
  const MAX = 200;

  const root = document.querySelector<HTMLElement>("[data-node-check]");
  if (root) {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const input = $<HTMLTextAreaElement>("[data-input]");
    const status = $<HTMLElement>("[data-status]");
    const startBtn = $<HTMLButtonElement>("[data-start]");
    const rowsEl = $<HTMLElement>("[data-rows]");
    const wrap = $<HTMLElement>("[data-result-wrap]");
    const summary = $<HTMLElement>("[data-summary]");
    const esc = (s: string) =>
      s.replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]!
      );

    type Res = NodeAddr & {
      ms: number | null;
      state: "ok" | "timeout" | "blocked" | "error" | "pending";
    };
    let results: Res[] = [];
    let running = false;

    /** 一次请求：成功或失败都算“有响应”，只有超时算无响应 */
    async function probe(n: NodeAddr): Promise<number | null> {
      const host = n.host.includes(":") ? `[${n.host}]` : n.host;
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TIMEOUT);
      const t0 = performance.now();
      try {
        await fetch(
          `https://${host}:${n.port}/?_=${Math.random().toString(36).slice(2)}`,
          { mode: "no-cors", cache: "no-store", signal: ctrl.signal }
        );
      } catch {
        if (ctrl.signal.aborted) {
          clearTimeout(timer);
          return null;
        }
      }
      clearTimeout(timer);
      return performance.now() - t0;
    }

    async function test(r: Res) {
      if (BLOCKED.has(r.port)) {
        r.state = "blocked";
        return;
      }
      const times: number[] = [];
      for (let i = 0; i < TRIES; i++) {
        const t = await probe(r);
        if (t === null) break;
        times.push(t);
      }
      if (!times.length) {
        r.state = "timeout";
        return;
      }
      // 第一次含 DNS 解析，取后几次中的最小值
      const best = Math.min(...(times.length > 1 ? times.slice(1) : times));
      r.ms = Math.round(best);
      r.state = r.ms < 3 ? "error" : "ok";
    }

    const color = (ms: number) =>
      ms < 100
        ? "text-signal"
        : ms < 200
          ? "text-amber-600"
          : ms < 300
            ? "text-orange-600"
            : "text-red-600";
    const STATE: Record<Res["state"], string> = {
      ok: '<span class="text-signal">有响应</span>',
      timeout: '<span class="text-red-600">超时</span>',
      blocked:
        '<span class="text-muted-foreground">浏览器禁止此端口，无法检测</span>',
      error: '<span class="text-muted-foreground">立即被拒绝，无法判断</span>',
      pending: '<span class="text-muted-foreground">检测中…</span>',
    };

    function render() {
      const sorted = [...results].sort((a, b) => (a.ms ?? 1e9) - (b.ms ?? 1e9));
      rowsEl.innerHTML = sorted
        .map(
          r => `<tr class="border-t">
            <td class="max-w-48 truncate px-3 py-2 font-semibold" title="${esc(r.name)}">${esc(r.name)}</td>
            <td class="num text-muted-foreground px-3 py-2 text-xs">${esc(r.host)}:${r.port}</td>
            <td class="num px-3 py-2 text-end font-bold ${r.ms !== null && r.state === "ok" ? color(r.ms) : ""}">${r.ms !== null && r.state === "ok" ? `${r.ms} ms` : "—"}</td>
            <td class="px-3 py-2 text-xs">${STATE[r.state]}</td>
          </tr>`
        )
        .join("");
      const ok = results.filter(r => r.state === "ok");
      const fastest = ok.sort((a, b) => a.ms! - b.ms!)[0];
      summary.innerHTML = [
        ["节点数", String(results.length)],
        ["有响应", String(ok.length)],
        ["最低延迟", fastest ? `${fastest.ms} ms` : "—"],
      ]
        .map(
          ([k, v]) =>
            `<div class="rounded-xl border bg-white px-2 py-2"><p class="text-muted-foreground text-xs">${k}</p><p class="num text-accent-strong text-lg font-extrabold">${v}</p></div>`
        )
        .join("");
    }

    async function run() {
      if (running) return;
      const nodes = parseNodes(input.value);
      if (!nodes.length) {
        status.textContent =
          "没有识别到节点地址，请按“域名:端口”或“IP:端口”每行一个输入。";
        return;
      }
      running = true;
      startBtn.disabled = true;
      startBtn.textContent = "检测中…";
      results = nodes
        .slice(0, MAX)
        .map(n => ({ ...n, ms: null, state: "pending" as const }));
      wrap.classList.remove("hidden");
      render();
      status.textContent =
        nodes.length > MAX
          ? `共识别 ${nodes.length} 个节点，只检测前 ${MAX} 个。`
          : `共 ${nodes.length} 个节点，检测中…`;
      let i = 0;
      const worker = async () => {
        while (i < results.length) {
          const r = results[i++];
          await test(r);
          render();
        }
      };
      await Promise.all(Array.from({ length: 6 }, worker));
      status.textContent = `检测完成：${results.filter(r => r.state === "ok").length} / ${results.length} 个节点有响应。`;
      running = false;
      startBtn.disabled = false;
      startBtn.textContent = "重新检测";
    }

    startBtn.addEventListener("click", run);
    $<HTMLButtonElement>("[data-clear]").addEventListener("click", () => {
      input.value = "";
      results = [];
      wrap.classList.add("hidden");
      status.textContent = "";
    });
    $<HTMLButtonElement>("[data-load]").addEventListener("click", async () => {
      const url = $<HTMLInputElement>("[data-sub-url]").value.trim();
      if (!/^https?:\/\//i.test(url)) {
        status.textContent = "请输入以 http:// 或 https:// 开头的订阅链接。";
        return;
      }
      status.textContent = "正在加载订阅…";
      try {
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) throw new Error(String(res.status));
        const text = await res.text();
        const nodes = parseNodes(text);
        if (!nodes.length) throw new Error("empty");
        input.value = nodes
          .map(n => `${n.host}:${n.port}  ${n.name}`)
          .join("\n");
        status.textContent = `已从订阅解析出 ${nodes.length} 个节点地址，点“开始检测”。`;
      } catch {
        status.textContent =
          "无法读取这个订阅（多数机场不允许网页跨域读取）。请在客户端里复制订阅内容或节点列表，粘贴到下方输入框。";
      }
    });
  }
</script>
