---
/**
 * 「网速测试」图标：仪表盘 + 指针 + 航线上的小飞机，呼应「机场测试」主题。
 * 纯 SVG，可任意缩放；颜色固定为站点信号蓝。
 */
type Props = { size?: number; class?: string; title?: string };
const { size = 40, class: cls, title } = Astro.props;
const id = `sti-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  class={cls}
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
>
  <defs>
    <linearGradient id={`${id}-bg`} x1="6" y1="4" x2="42" y2="46">
      <stop offset="0" stop-color="#3b8cff"></stop>
      <stop offset="1" stop-color="#0a4fd6"></stop>
    </linearGradient>
    <linearGradient id={`${id}-arc`} x1="10" y1="0" x2="38" y2="0">
      <stop offset="0" stop-color="#7ee7ff"></stop>
      <stop offset="1" stop-color="#ffffff"></stop>
    </linearGradient>
  </defs>
  <rect width="48" height="48" rx="13" fill={`url(#${id}-bg)`}></rect>
  <path
    d="M10.5 31a13.5 13.5 0 1 1 27 0"
    stroke="rgba(255,255,255,.28)"
    stroke-width="3.2"
    stroke-linecap="round"></path>
  <path
    d="M10.5 31a13.5 13.5 0 0 1 22.6-9.95"
    stroke={`url(#${id}-arc)`}
    stroke-width="3.2"
    stroke-linecap="round"></path>
  <path
    d="M24 31 31.2 22.4"
    stroke="#fff"
    stroke-width="2.6"
    stroke-linecap="round"></path>
  <circle cx="24" cy="31" r="3" fill="#fff"></circle>
  <path d="M33.6 12.6 39.4 10l-2.6 5.8-1-1.9-2.6 1.3.6-1.4-1.3-.7Z" fill="#fff"
  ></path>
  <path
    d="M12 38h24"
    stroke="rgba(255,255,255,.5)"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-dasharray="2 3"></path>
</svg>
