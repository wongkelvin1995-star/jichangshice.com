---
/** 文章缩略图：按栏目生成的原创 SVG 插画（无外部图片，体积小） */
type Props = { category: string; class?: string };
const { category, class: className } = Astro.props;
const themes: Record<string, [string, string]> = {
  methods: ["#2a7bff", "#7fb4ff"],
  guides: ["#11a36f", "#7de3bd"],
  clients: ["#6a3df0", "#b7a2ff"],
  routes: ["#0e9fc4", "#8fe3f3"],
  troubleshooting: ["#f47b1f", "#ffc68a"],
  ai: ["#e23d7b", "#ff9fc4"],
};
const [a, b] = themes[category] ?? themes.methods;
const gid = `at-${category}`;
---

<svg viewBox="0 0 160 100" class={className} aria-hidden="true">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={b}></stop>
      <stop offset="1" stop-color={a}></stop>
    </linearGradient>
  </defs>
  <rect width="160" height="100" rx="12" fill={`url(#${gid})`}></rect>
  <circle cx="132" cy="18" r="34" fill="#fff" opacity="0.12"></circle>
  {
    category === "methods" && (
      <g fill="#fff">
        <rect x="34" y="58" width="12" height="22" rx="3" opacity="0.7" />
        <rect x="54" y="44" width="12" height="36" rx="3" opacity="0.85" />
        <rect x="74" y="30" width="12" height="50" rx="3" />
        <rect x="94" y="48" width="12" height="32" rx="3" opacity="0.8" />
        <rect x="114" y="38" width="12" height="42" rx="3" opacity="0.9" />
      </g>
    )
  }
  {
    category === "guides" && (
      <g>
        <rect x="46" y="22" width="68" height="58" rx="8" fill="#fff" />
        <path
          d="M58 40h44M58 52h44M58 64h28"
          stroke={a}
          stroke-width="5"
          stroke-linecap="round"
        />
      </g>
    )
  }
  {
    category === "clients" && (
      <g>
        <rect x="30" y="26" width="72" height="48" rx="6" fill="#fff" />
        <rect
          x="106"
          y="34"
          width="26"
          height="44"
          rx="6"
          fill="#fff"
          opacity="0.9"
        />
        <path
          d="M44 42h40M44 54h28"
          stroke={a}
          stroke-width="5"
          stroke-linecap="round"
        />
      </g>
    )
  }
  {
    category === "routes" && (
      <g stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none">
        <path d="M34 70 C60 30, 90 80, 126 30" />
        <circle cx="34" cy="70" r="7" fill="#fff" />
        <circle cx="80" cy="54" r="6" fill="#fff" />
        <circle cx="126" cy="30" r="7" fill="#fff" />
      </g>
    )
  }
  {
    category === "ai" && (
      <g>
        <rect x="52" y="28" width="56" height="44" rx="12" fill="#fff" />
        <circle cx="70" cy="50" r="5" fill={a} />
        <circle cx="90" cy="50" r="5" fill={a} />
        <path
          d="M80 18v10"
          stroke="#fff"
          stroke-width="4"
          stroke-linecap="round"
        />
        <circle cx="80" cy="16" r="4" fill="#fff" />
      </g>
    )
  }
  {
    category === "troubleshooting" && (
      <g>
        <circle cx="80" cy="50" r="28" fill="#fff" />
        <path
          d="M80 36v18"
          stroke={a}
          stroke-width="6"
          stroke-linecap="round"
        />
        <circle cx="80" cy="64" r="4" fill={a} />
      </g>
    )
  }
</svg>
