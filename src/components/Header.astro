---
import Logo from "./Logo.astro";
import { MAIN_NAV, FULL_NAV } from "@/data/navigation";
import config from "@/config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
const host = new URL(config.site.url).hostname;
const tg = config.telegramUrl;
const gh = config.githubUrl;
---

<a
  href="#main-content"
  class="bg-accent text-accent-foreground fixed start-4 -top-20 z-[60] rounded px-3 py-2 focus:top-3"
>
  跳到正文
</a>

<header
  class="sticky top-0 z-40 border-b border-white/60 bg-white/85 backdrop-blur-md"
  id="site-header"
>
  <div class="app-layout flex h-(--header-h) items-center gap-2 sm:gap-4">
    <a
      href="/"
      class="flex min-w-0 items-center gap-2.5"
      aria-label="机场测试 首页"
    >
      <Logo size={34} />
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="text-[1.15rem] font-black tracking-tight whitespace-nowrap"
          >{config.site.title}</span
        >
        <span class="text-muted-foreground truncate text-[0.72rem]">{host}</span
        >
      </span>
    </a>

    <nav aria-label="主导航" class="ms-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          MAIN_NAV.map(item => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "relative block rounded-full px-2.5 py-2 text-[0.94rem] whitespace-nowrap transition-colors 2xl:px-3.5",
                  isActive(item.href)
                    ? "bg-accent-soft text-accent-strong font-bold"
                    : "text-foreground/80 hover:text-accent-strong",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-1 sm:gap-2 lg:ms-4">
      <a
        href="/search/"
        id="search-open"
        class="bg-surface text-muted-foreground hover:border-accent/40 hidden h-11 w-56 items-center gap-2 rounded-full border px-4 text-sm md:flex lg:w-44 2xl:w-64"
        aria-label="搜索（Ctrl+K）"
        aria-haspopup="dialog"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
          ></path></svg
        >
        <span class="flex-1 truncate">搜索机场、教程、问题…</span>
      </a>
      <button
        type="button"
        data-search-trigger
        class="hover:bg-muted flex size-10 items-center justify-center rounded-full sm:size-11 md:hidden"
        aria-label="搜索"
        aria-haspopup="dialog"
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
          ></path></svg
        >
      </button>
      <a
        href="/user/"
        class:list={[
          "flex size-10 shrink-0 items-center justify-center gap-1.5 rounded-full text-[0.94rem] transition-colors sm:size-11 xl:h-11 xl:w-auto",
          "xl:border xl:px-3.5",
          isActive("/user/")
            ? "bg-accent-soft text-accent-strong xl:border-accent/30 font-bold"
            : "text-foreground/80 hover:text-accent-strong xl:bg-surface hover:bg-muted xl:hover:border-accent/40",
        ]}
        aria-label="个人中心"
        title="个人中心：收藏、浏览历史、比较清单"
        aria-current={isActive("/user/") ? "page" : undefined}
        data-user-center
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="8" r="5"></circle><path d="M20 21a8 8 0 0 0-16 0"
          ></path></svg
        >
        <span class="hidden whitespace-nowrap xl:inline">个人中心</span>
      </a>
      {
        tg && (
          <a
            href={tg}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden size-11 items-center justify-center rounded-full text-white shadow-[0_6px_16px_-6px_rgb(26_109_255/0.7)] sm:flex"
            style="background:linear-gradient(160deg,#4b93ff,#1a6dff)"
            aria-label="机场测试 Telegram 交流频道"
            title="TG 交流频道"
          >
            <svg
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M21.9 4.3 18.6 20c-.2 1.1-.9 1.4-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.2-8.3c.4-.4-.1-.6-.6-.2L6 13.6l-4.9-1.5c-1.1-.3-1.1-1.1.2-1.6L20.5 3c.9-.3 1.7.2 1.4 1.3Z" />
            </svg>
          </a>
        )
      }
      {
        gh && (
          <a
            href={gh}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden size-11 items-center justify-center rounded-full bg-[#1f2328] text-white shadow-[0_6px_16px_-6px_rgb(31_35_40/0.6)] hover:bg-[#32383f] sm:flex"
            aria-label="机场测试 GitHub 仓库"
            title="GitHub 仓库"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
            </svg>
          </a>
        )
      }
      <button
        id="menu-btn"
        type="button"
        class="hover:bg-muted flex size-10 items-center justify-center rounded-full sm:size-11 lg:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
        <svg
          id="close-icon"
          class="hidden"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg
        >
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="手机菜单"
    class="hidden border-t bg-white lg:hidden"
  >
    <ul class="app-layout grid grid-cols-2 gap-1.5 py-3 sm:grid-cols-3">
      {
        FULL_NAV.map(item => (
          <li>
            <a
              href={item.href}
              class:list={[
                "block rounded-xl border px-3 py-3 text-base",
                isActive(item.href)
                  ? "bg-accent-soft text-accent-strong border-accent/30 font-semibold"
                  : "hover:bg-muted",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      {
        tg && (
          <li class="col-span-2 sm:col-span-3">
            <a
              href={tg}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-accent-foreground block rounded-xl px-3 py-3 text-center font-semibold"
            >
              加入 TG 交流频道
            </a>
          </li>
        )
      }
      {
        gh && (
          <li class="col-span-2 sm:col-span-3">
            <a
              href={gh}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-xl bg-[#1f2328] px-3 py-3 text-center font-semibold text-white"
            >
              GitHub 仓库
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");
  function setMenu(open: boolean) {
    if (!btn || !menu) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
    menu.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }
  btn?.addEventListener("click", () =>
    setMenu(btn.getAttribute("aria-expanded") !== "true")
  );
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      btn.focus();
    }
  });
  window
    .matchMedia("(min-width: 1024px)")
    .addEventListener("change", e => e.matches && setMenu(false));
</script>
