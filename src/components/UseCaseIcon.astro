---
type Props = { name: string };
const { name } = Astro.props;
---

<svg
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "ai" && (
      <>
        <rect x="4" y="6" width="16" height="12" rx="3" />
        <path d="M9 11h.01M15 11h.01M9.5 15h5M12 3v3" />
      </>
    )
  }
  {
    name === "video" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="3" />
        <path d="m10 9 5 3-5 3z" />
      </>
    )
  }
  {
    name === "wallet" && (
      <>
        <path d="M4 7h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
        <path d="M4 7l11-3v3M16 13h.01" />
      </>
    )
  }
  {
    name === "phone" && (
      <>
        <rect x="7" y="3" width="10" height="18" rx="2.5" />
        <path d="M11 18h2" />
      </>
    )
  }
</svg>
