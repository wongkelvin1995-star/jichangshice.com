---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SearchDialog from "@/components/SearchDialog.astro";
import Analytics from "@/components/Analytics.astro";
import config from "@/config";
import { absoluteUrl } from "@/utils/format";
import { PUBLIC_BING_SITE_VERIFICATION } from "astro:env/client";
import "@/styles/global.css";

type Props = {
  /** 完整 <title>（每页独立） */
  title: string;
  /** 根据页面内容单独撰写的 meta description */
  description: string;
  /** 规范路径，默认当前路径（含结尾斜杠） */
  canonicalPath?: string;
  ogImage?: string;
  /** 分享图的替代文字；默认用站点说明，页面使用自己的分享图时请一并传入 */
  ogImageAlt?: string;
  /** 分享图的实际尺寸；默认 1200×630（站点默认分享图） */
  ogImageSize?: { width: number; height: number };
  ogType?: "website" | "article";
  noindex?: boolean;
  /** JSON-LD 对象，必须与页面实际内容一致 */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = config.site.ogImage,
  ogImageAlt = `${config.site.title}：机场测速数据、测试档案与在线机场测速工具`,
  ogImageSize = { width: 1200, height: 630 },
  ogType = "website",
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = absoluteUrl(canonicalPath);
const ogImageURL = absoluteUrl(ogImage);
const googleVerification = config.site.googleVerification;
const bingVerification = PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={config.site.lang} dir="ltr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 个人中心“字号”偏好：首屏前应用，避免闪烁（数据只在本地浏览器）
      try {
        var jcPrefs = JSON.parse(localStorage.getItem("jc:prefs") || "{}");
        if (jcPrefs && jcPrefs.fontSize === "large")
          document.documentElement.dataset.font = "large";
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalPath !== "" && <link rel="canonical" href={canonicalURL} />}
    <link
      rel="alternate"
      type="application/json"
      href="/search-index.json"
      title="站内搜索索引"
      data-search-index
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={absoluteUrl("/rss.xml")}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalPath !== "" && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }
    {
      bingVerification && (
        <meta name="msvalidate.01" content={bingVerification} />
      )
    }

    {
      jsonLd.map(obj => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(obj)}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body
    class="bg-background text-foreground font-app flex min-h-svh flex-col antialiased"
  >
    <div class="site-bg" aria-hidden="true">
      <span class="site-bg__blob site-bg__blob--a"></span>
      <span class="site-bg__blob site-bg__blob--b"></span>
      <span class="site-bg__blob site-bg__blob--c"></span>
    </div>
    <Header />
    <slot />
    <Footer />
    <SearchDialog />
    <Analytics />
  </body>
</html>
